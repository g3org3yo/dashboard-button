+function shimUrl(globalKey: PluginGlobalKey): string {
+  const names = Object.keys(pluginNamespaces()[globalKey]).filter(
+    name => name !== 'default' && /^[A-Za-z_$][\w$]*$/.test(name)
+  )
 
   const source =
